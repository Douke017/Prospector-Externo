# HU-15: Catalog API Facade persistente. Sin Chromium/Playwright.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/src

WORKDIR /app
COPY . /app
RUN python -m pip install --no-cache-dir '.[mongo]'

EXPOSE 8000
# Uso del mismo endpoint público utilizado por las pruebas del catálogo.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)" || exit 1
CMD ["python", "-m", "uvicorn", "apps.catalog_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
